{
  "manifest_version": 3,

  "name": "Calm YouTube Home",
  "version": "0.2.0",

  "description": "Compact text-first YouTube homepage",

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],

      "js": [
        "content.js"
      ],

      "css": [
        "styles.css"
      ],

      "run_at": "document_start"
    }
  ]
}
